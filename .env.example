SUPABASE_PROJECT_ID=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-only application secrets
STAFF_PASSWORD=
# Server-side developer tools password. Developer sign-in is disabled when unset.
DEVELOPER_PASSWORD=
# HMAC key for developer sessions (falls back to STAFF_PASSWORD)
DEVELOPER_SESSION_SECRET=
# Separate HMAC key for irreversible rate-limit identities (falls back to STAFF_PASSWORD or DEVELOPER_SESSION_SECRET)
RATE_LIMIT_SECRET=
AMBASSADOR_PASSWORD=
INITIAL_REVIEWER_ACCESS_CODE=
SENDGRID_API_KEY=
# Optional read-only Gmail sync for reviewer replies sent to NYRJINFO@gmail.com.
# The refresh token must belong to that mailbox and have the gmail.readonly scope.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
# Random 16+ character secret used by the Vercel daily reminder cron
CRON_SECRET=

# Canonical deployed origin used in transactional email links
PUBLIC_SITE_URL=https://nyrj.org

# Optional integrations
OPENAI_API_KEY=
# Backward-compatible alternative to OPENAI_API_KEY
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_MODERATION_MODEL=omni-moderation-latest
MICROSOFT_EXCEL_API_KEY=
MICROSOFT_GRAPH_ACCESS_TOKEN=
LOVABLE_API_KEY=
GOOGLE_SEARCH_CONSOLE_API_KEY=
